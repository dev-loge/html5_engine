public var speed = number;
public var sprintSpeed = number;
public var controlScheme = Object;

var input = Engine.input;
var inputMap = new Map();

var xPos = GameObject.getPosition('x');
var yPos = GameObject.getPosition('y');

public function start() {
    // Initialize input map from control scheme
    Object.keys(controlScheme).forEach(direction => {
        controlScheme[direction].forEach(key => {
            inputMap.set(key, direction);
        });
    });
}

public function update() {
    var xPos = GameObject.getPosition('x');
    var yPos = GameObject.getPosition('y');
    var deltaX = 0;
    var deltaY = 0;
    
    // Determine if sprinting
    var velocity = input.keysDown.has(controlScheme.sprint[0]) ? sprintSpeed : speed;
    
    // Check each key pressed and accumulate direction
    input.keysDown.forEach(key => {
        var direction = inputMap.get(key);
        
        if (direction === '-y') deltaY -= 1;
        if (direction === '+y') deltaY += 1;
        if (direction === '-x') deltaX -= 1;
        if (direction === '+x') deltaX += 1;
    });
    
    // Normalize movement to prevent faster diagonal movement
    if (deltaX !== 0 || deltaY !== 0) {
        var magnitude = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
        deltaX = (deltaX / magnitude) * velocity;
        deltaY = (deltaY / magnitude) * velocity;
        
        this.gameObject.setPosition(xPos + deltaX, yPos + deltaY);
    }
}