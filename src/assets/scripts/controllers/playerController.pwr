
var input = Engine.input;
var time = Engine.time;
var drawComp = GameObject.getComponentByName('Graphics');
var kit = GameObject.getComponentByName('Kit');

public var availActions = ['primaryFire', 'ability1', 'ability2', 'ability3', 'ability4'];
public var targeting = 'none';

public function start() {
    var pos = GameObject.position;
    var color = drawComp.shapes[0].color;


    GameObject.setProperty('selected', false)
    GameObject.setProperty('destination', pos)
    GameObject.setProperty('movementLocked', false)
    GameObject.setProperty('inputLocked', false)    
    
    GameObject.setProperty('origColor', color)
    GameObject.setProperty('color', color)
}

public function update() {
    var mPos = input.mousePosition;

    var pos = GameObject.position;
    var r = GameObject.size.r;
   
    var selected = GameObject.selected || false;
    var destination = GameObject.destination || {x:pos.x, y:pos.y};
    var health = GameObject.health || null;
    
    var speed = GameObject.speed || 0;
    //console.log(GameObject)

    //cleanup hitscan shapes
    drawComp.shapes = drawComp.shapes.filter(shape => shape.name !== 'shot')

    drawComp.shapes[0].color = GameObject.color;
    
    // ====================== Input Handling ==========================
    if (targeting === 'none') {
        // select player
        if (isInsideCircle(mPos.x, mPos.y, pos.x, pos.y, r)) {
            GameObject.setProperty('color', 'yellow')
        } else if (GameObject.color === 'yellow' && GameObject.color != GameObject.origColor) {
            GameObject.setProperty('color', GameObject.origColor)
        }

        // control player
        if (selected && !GameObject.inputLocked) {
            // move to click location
            if (input.mouseButtonsDown.has('left') && !GameObject.movementLocked) {
                GameObject.setProperty('destination', {x: mPos.x, y: mPos.y})
            }

            // primaryFire
            if (input.isKeyDown(' ') && pos.x !== mPos.x && pos.y !== mPos.y && availActions.includes('primaryFire')) {
                kit.primaryFireShoot(pos, mPos)
                availActions.splice(availActions.indexOf('primaryFire'), 1);
            }

            // ability input
            var ablArr = ['q','w','e','r'];
            for (var i = 0; i < ablArr.length; i++) {
                if (input.isKeyDown(ablArr[i]) && 
                    pos.x !== mPos.x && pos.y !== mPos.y && 
                    availActions.includes(`ability${i+1}`)) {
                        kit[`ability${i+1}Cast`](pos, mPos);
                        availActions.splice(availActions.indexOf(`ability${i+1}`, 1))
                    }
            }
        }
    } else {
        
        // targeting mode
        if (input.mouseButtonsDown.has('left')) {
            switch (targeting) {
                case 'pos':
                    GameObject.target = mPos;
                    break;
                case 'hero':

                    break;
                case 'enemy':

                    break;
                default:
                    console.warn(`Invalid targeting type: ${targeting}`);
                    break;
            }
            targeting = 'none';
        }
    }
    

    

    // =================== Movement ==============================
    var xDistance = destination.x - pos.x;
    var yDistance = destination.y - pos.y;
    
    var moveX = 0;
    var moveY = 0;

    if (xDistance < 0) moveX = xDistance < speed * -1 ? speed * -1 : xDistance;
    else moveX = xDistance > speed ? speed : xDistance;

    if (yDistance < 0) moveY = yDistance < speed * -1 ? speed * -1 : yDistance;
    else moveY = yDistance > speed ? speed : yDistance;

    var newPos = {
        x: pos.x + moveX,
        y: pos.y + moveY
    };

    if (!GameObject.movementLocked) GameObject.setProperty('position', {x: newPos.x, y: newPos.y})
}

public function takeDamage(amount) {
    if (amount < 0) {
        console.warn('invalid dmg amount')
        return;
    }

    if (amount > GameObject.health) amount = GameObject.health;
    GameObject.health -= amount;
    
    GameObject.setProperty('color', 'red')
    time.setTimer(`${GameObject.name} dmg`, 0.1, () => {
        GameObject.setProperty('color', GameObject.origColor);
    })

    if (GameObject.health === 0) this.die()

    return GameObject.health;
}

public function requestTarget (type) {
    targeting = type;
}

public function die() {
    GameObject.destroy()
}

function isInsideCircle(x, y, centerX, centerY, radius) {
    // Calculate the squared distance
    const distanceSquared = (x - centerX) ** 2 + (y - centerY) ** 2;
    
    // Check if it's less than the squared radius
    return distanceSquared < radius ** 2;
}

