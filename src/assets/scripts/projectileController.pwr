
public var ownerId = number;
public var speed = number;
public var damage = number;
public var dirX = number;
public var dirY = number;

var GameManager = Engine.gameObjectRegistry.get(0);
var boundary = GameManager.getComponentByName('Hitbox');

var hitbox = GameObject.getComponentByName('Hitbox');
var size = GameObject.size.r;

var canvasSize = {
    w: Engine.canvas.width,
    h: Engine.canvas.height
};

public function update() {
    // update position
    var position = GameObject.position; // {x, y}
    var velocity = {
        x: dirX * speed,
        y: dirY * speed
    };

    GameObject.setProperty('position',
        {
            x: position.x + velocity.x,
            y: position.y + velocity.y
        }
    );

    //detect hits
    //console.log(hitbox.collisions)
    for (var collision of hitbox.collisions) {
        var collGameObject = collision[0].gameObject;
        if (collGameObject.id === ownerId) continue;

        switch(collision[1]) {
            case 'onEnter':
                if (collGameObject.health) {
                    var collController = collGameObject.getComponentByName('Controller');
                    collController.takeDamage(damage);
                    GameObject.destroy();
                }
                break;
            case 'isColliding':
                break;
            case 'onExit':
                if (collGameObject.name === 'Game Manager') GameObject.destroy();
                break;
        }
    }

    //destroy if out of bounds

    /*
    if (position.x > canvasSize.w + size ||
        position.y > canvasSize.h + size ||
        position.x < size * -1 ||
        position.y < size * -1) {
            GameObject.destroy()
        }
    //*/
}