public var targetScene = string;

var hitbox = GameObject.getComponentByType('hitbox');

public function start() {
    // runs once before game loop begins
}

public function update() {
    hitbox.collisions.forEach((type, coll) => {
        if (type === 'onEnter' && coll.name === 'Player') {
            Engine.goToScene(targetScene)
        }
    });
}