
var time = Engine.time;

var playerController = GameObject.getComponentByName('Controller');
var drawComp = GameObject.getComponentByName('Graphics');

public var maxHealth = number;
public var speed = number;

public var primaryFire = object;
public var ability1 = object;
public var ability2 = object;

// setup
public function awake() {
    GameObject.setProperty('maxHealth', maxHealth)
    GameObject.setProperty('health', maxHealth)
    GameObject.setProperty('speed', speed)
    
    //console.log(GameObject)
}

// utils
public function recieveTargets() {
    console.log(GameObject.target)
}

// primary fire
public class FireBlast {
    constructor(inputObj) {
        var stats = inputObj.stats;
        var path = inputObj.path;

        this.template = 'combat/projectile.json';
        this.position = path.origin;
        this.size = stats.size;
        this.componentData = {
            Controller: {
                data: {
                    ownerId: GameObject.id,
                    stats: {
                        damage: stats.damage,
                        speed: stats.speed,
                        range: stats.range,
                        pierce: stats.pierce
                    },
                    path: path,
                    graphics: inputObj.graphics
                }
            },
            Effect: {
                type: 'Script',
                script: 'kits/Fire Fellow/fire_fellow_primary_effect.pwr',
                data: {
                    ownerId: GameObject.id,
                    damage: stats.explosion.damage,
                    radius: stats.explosion.radius
                }
            }
        };
    }
}

public function primaryFireShoot(pos, dir) {
    // create projectile
    var dx = dir.x - pos.x;
    var dy = dir.y - pos.y;
    var length = Math.sqrt(dx * dx + dy * dy);
    
    var dirX = length != 0 ? dx / length : 0;
    var dirY = length != 0 ? dy / length : 0;

    var inputObj = {
        stats: primaryFire.stats,
        path: {
            origin: pos,
            dir: new Vector2(dirX, dirY)
        },
        graphics: primaryFire.graphics
    }

    var projectile = new FireBlast(inputObj)
    Scene.createGameObject(projectile)

    // re-enable primaryFire after 'primaryFire.stats.fireRate' seconds
    time.setTimer('fireFellowPF', primaryFire.stats.fireRate, () => {
        playerController.availActions.push('primaryFire')
    })
}

//ability1
public function ability1Cast () {
    playerController.requestTarget('pos')
    console.log('fire dash!')
}


// ability 2
public class outburst {
    constructor(inputObj) {
        var stats = inputObj.stats;
        var graphics = inputObj.graphics;

        this.template = 'combat/explosion.json',
        this.position = GameObject.position,
        this.size = {
            r: stats.radius,
        }
        this.componentData = {
            Controller: {
                ownerId: GameObject.id,
                damage: stats.damage,
                radius: stats.radius
            }
        }
    }
}

public function ability2Cast () {

    var inputObj = {
        stats: ability2.stats,
        graphics: ability2.graphics
    }

    //begin channel
    GameObject.color = 'orange'
    GameObject.setProperty('inputLocked', true);
    GameObject.setProperty('movementLocked', true)
    time.setTimer('fireFellowCast1', ability2.stats.castTime, () => {
        GameObject.color = GameObject.origColor;
        GameObject.setProperty('inputLocked', false)
        GameObject.setProperty('movementLocked', false)
        Scene.createGameObject(new outburst(inputObj))
    })

    // re-enable ability after 'stats.cooldown' seconds
    time.setTimer('fireFellowCooldown1', ability2.stats.cooldown, () => {
        playerController.availActions.push('ability2')
    })
}
