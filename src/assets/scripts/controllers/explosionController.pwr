
public var ownerId = number;
public var damage = number;
public var radius = number;

var hitbox = GameObject.getComponentByName('Hitbox');
var drawComp = GameObject.getComponentByName('Graphics');
var damagedTargets = new Set();

var frames = 0;

public function awake () {
    //setup
    hitbox.size.r = radius;
    drawComp.shapes.push({
        shape: 'circle',
        size: {
            r: radius
        },
        color: 'red',
        fill: false,
        strokeSize: 1
    })
}

public function update () {
    frames++;

    if (!hitbox || !hitbox.collisions) {
        if (frames > 2) GameObject.destroy();
        return;
    }

    for (var collision of hitbox.collisions) {
        var collHitbox = collision[0];
        var collType = collision[1];
        var collGameObject = collHitbox.gameObject;
        if (!collGameObject) continue;

        // Explosion should only deal one-time entry damage.
        if (collType !== 'onEnter') continue;
        if (collGameObject.id === ownerId) continue;
        if (damagedTargets.has(collGameObject.id)) continue;

        var collController = collGameObject.getComponentByName('Controller');
        var canTakeDamage = collGameObject.health !== undefined && collGameObject.health !== null && collController && typeof collController.takeDamage === 'function';
        if (!canTakeDamage || !damage) continue;

        collController.takeDamage(damage);
        damagedTargets.add(collGameObject.id);
    }

    if (frames > 2) GameObject.destroy()
}