
var input = Engine.input;
var drawComp = GameObject.getComponentByName('Graphics');
var kit = GameObject.getComponentByName('Kit');

var damaged = false;
var color = drawComp.shapes[0].color;

public function start() {
    var pos = GameObject.position;

    GameObject.setProperty('selected', false)
    GameObject.setProperty('destination', pos)
}

public function update() {
    var mPos = input.mousePosition;

    var pos = GameObject.position;
    var thisRadius = GameObject.size.r;
   
    var selected = GameObject.selected || false;
    var destination = GameObject.destination || {x:pos.x, y:pos.y};
    var health = GameObject.health || null;
    
    var speed = GameObject.speed || 0;
    //console.log(GameObject)

    //cleanup hitscan shapes
    drawComp.shapes = drawComp.shapes.filter(shape => shape.name !== 'shot')
    
    // ====================== Input Handling ==========================
    // select player
    if (isInsideCircle(mPos.x, mPos.y, pos.x, pos.y, thisRadius)) {
        drawComp.shapes[0].color = 'yellow';

        if (input.mouseButtonsDown.has('left')) {
            GameObject.setProperty('selected', true)
        }

    } else {
        if (selected) drawComp.shapes[0].color = 'yellow'
        else drawComp.shapes[0].color = color
    }

    // unselect player
    if (input.mouseButtonsDown.has('right')) {
        GameObject.setProperty('selected', false)
    }

    // control player
    if (selected) {
        // move to click location
        if (input.mouseButtonsDown.has('left')) {
            GameObject.setProperty('destination', {x: mPos.x, y: mPos.y})
        }

        // shoot
        if (input.isKeyPressed(' ') && pos.x !== mPos.x && pos.y !== mPos.y) {
            kit.shoot(pos, mPos)
        }

        // ability 1
        if (input.isKeyPressed('q') && pos.x !== mPos.x && pos.y !== mPos.y) {
            kit.ability1(pos, mPos)
        }
    }

    

    // =================== Movement ==============================
    var xDistance = destination.x - pos.x;
    var yDistance = destination.y - pos.y;
    
    var moveX = 0;
    var moveY = 0;

    if (xDistance < 0) moveX = xDistance < speed * -1 ? speed * -1 : xDistance;
    else moveX = xDistance > speed ? speed : xDistance;

    if (yDistance < 0) moveY = yDistance < speed * -1 ? speed * -1 : yDistance;
    else moveY = yDistance > speed ? speed : yDistance;

    var newPos = {
        x: pos.x + moveX,
        y: pos.y + moveY
    };

    GameObject.setProperty('position', {x: newPos.x, y: newPos.y})

    // =================== Damage & Death Animations ==============================
    var thisColor = drawComp.shapes[0].color;

    if (damaged) {
        thisColor = color;
        damaged = false;
    }

    
}

public function takeDamage(amount) {
    if (amount < 0) {
        console.warn('invalid dmg amount')
        return;
    }

    if (amount > GameObject.health) amount = GameObject.health;
    GameObject.health -= amount;
    
    damaged = true;
    drawComp.shapes[0].color = 'red';

    if (GameObject.health === 0) this.die()

    return GameObject.health;
}

public function die() {
    GameObject.destroy()
}

function isInsideCircle(x, y, centerX, centerY, radius) {
    // Calculate the squared distance
    const distanceSquared = (x - centerX) ** 2 + (y - centerY) ** 2;
    
    // Check if it's less than the squared radius
    return distanceSquared < radius ** 2;
}